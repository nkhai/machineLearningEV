version: 1.0

# Environment Variables Template
# Copy this to .env and update with your values

# ============================================
# PostgreSQL Configuration
# ============================================
POSTGRES_USER=lakehouse
POSTGRES_PASSWORD=change-me
POSTGRES_DB=metastore
POSTGRES_MULTIPLE_DATABASES=airflow,hive_metastore
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=change-me

# ============================================
# Airflow Configuration
# ============================================
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_ADMIN_EMAIL=admin@example.com
AIRFLOW_DB=airflow
FERNET_KEY=change-me-to-a-32-byte-base64-key
AIRFLOW_EXECUTOR=CeleryExecutor

# ============================================
# Kafka Configuration
# ============================================
KAFKA_BROKER_1=kafka-broker-1:9092
KAFKA_BROKER_2=kafka-broker-2:9093
KAFKA_BROKER_3=kafka-broker-3:9094
KAFKA_BOOTSTRAP_SERVERS=kafka-broker-1:9092,kafka-broker-2:9093,kafka-broker-3:9094

# ============================================
# HDFS Configuration
# ============================================
HDFS_NAMENODE=namenode
HDFS_PORT=8020
HDFS_URL=hdfs://namenode:8020

# ============================================
# Spark Configuration
# ============================================
SPARK_MASTER=spark://spark-master:7077
SPARK_MASTER_HOST=spark-master
SPARK_MASTER_PORT=7077
SPARK_MASTER_WEBUI_PORT=8080

# ============================================
# YARN Configuration
# ============================================
YARN_RESOURCEMANAGER=resourcemanager
YARN_RESOURCEMANAGER_PORT=8032
YARN_WEBAPP_PORT=8088

# ============================================
# Delta Lake Configuration
# ============================================
DELTA_LAKE_PATH=hdfs://namenode:8020/delta/lakehouse
DELTA_CHECKPOINT_PATH=hdfs://namenode:8020/spark-checkpoints
